{:paths ["src" "resources"
         ;"target/classes"
         ]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        ;org.clojure/core.async {:mvn/version "1.10.874-alpha3"}


        top.kzre/krro-core {:mvn/version "0.1.0"}
        top.kzre/krro-ui-javafx {:mvn/version "0.1.0"}
        top.kzre/krro-brush {:mvn/version "0.1.0"}

        top.kzre/krro-plugin-undo {:mvn/version "0.1.0"}

        top.kzre/krro-canvas-core {:mvn/version "0.1.0"}
        top.kzre/krro-canvas-raster {:mvn/version "0.1.0"}
        top.kzre/krro-canvas-vector {:mvn/version "0.1.0"}
        top.kzre/krro-canvas-perspective {:mvn/version "0.1.0"}
        top.kzre/krro-canvas-gl {:mvn/version "0.1.0"}

        ;; 图像IO支持
        com.twelvemonkeys.imageio/imageio-core {:mvn/version "3.15.3"}
        com.twelvemonkeys.imageio/imageio-metadata {:mvn/version "3.15.3"}
        com.twelvemonkeys.imageio/imageio-tiff {:mvn/version "3.15.3"}   ; TIFF / BigTIFF
        com.twelvemonkeys.imageio/imageio-jpeg {:mvn/version "3.15.3"}   ; JPEG（比 JDK 内置支持更广）
        com.twelvemonkeys.imageio/imageio-bmp  {:mvn/version "3.15.3"}
        com.twelvemonkeys.imageio/imageio-pnm  {:mvn/version "3.15.3"}   ; PPM/PGM/PBM
        com.twelvemonkeys.imageio/imageio-psd  {:mvn/version "3.15.3"}   ; PSD 读取
        com.twelvemonkeys.imageio/imageio-webp {:mvn/version "3.15.3"}   ; WebP 读取
        com.twelvemonkeys.imageio/imageio-hdr  {:mvn/version "3.15.3"}   ; RGBE/HDR

        com.taoensso/timbre {:mvn/version "6.3.1"}
        com.taoensso/tufte {:mvn/version "2.6.3"}
        }

 :aliases
 {:build
  {:deps {io.github.huixiangchen0314/clj-build-template
          {:git/sha "5664761b0ee0aad60f587d14d00ccd8b2dc985e7"}
          org.slf4j/slf4j-nop {:mvn/version "2.0.7"}}
   :ns-default build}
  :run
  {:extra-paths ["target/classes"]
   :main-opts ["-m" "top.kzre.krro.app.core"]}}}